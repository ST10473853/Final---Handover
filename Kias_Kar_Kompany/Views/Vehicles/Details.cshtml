@model Kias_Kar_Kompany.Models.Vehicle

@{
    ViewData["Title"] = "Vehicle Details";
}

<div class="container mt-4">

    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">🚘 Vehicle Details</h3>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">Vehicle ID</dt>
                <dd class="col-sm-9">@Model.VehicleId</dd>

                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.VehicleName</dd>

                <dt class="col-sm-3">Model</dt>
                <dd class="col-sm-9">@Model.VehicleModel</dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">R @Model.VehiclePrice</dd>

                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-info text-dark">
                        @Model.VehicleType
                    </span>
                </dd>

            </dl>

            <a asp-action="Index" class="btn btn-secondary">
                ← Back to List
            </a>

        </div>
    </div>
</div>