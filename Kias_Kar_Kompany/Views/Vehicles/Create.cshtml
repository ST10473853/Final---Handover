@model Kias_Kar_Kompany.Models.Vehicle

@{
    ViewData["Title"] = "Add Vehicle";
}

<div class="container mt-4">

    <div class="card shadow-lg border-0">
        <div class="card-header bg-success text-white">
            <h3>➕ Add New Vehicle</h3>
        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label class="form-label">Vehicle Name</label>
                    <input asp-for="VehicleName" class="form-control" placeholder="e.g BMW X5" />
                    <span asp-validation-for="VehicleName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Vehicle Model</label>
                    <input asp-for="VehicleModel" class="form-control" placeholder="e.g 2024" />
                    <span asp-validation-for="VehicleModel" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Price</label>
                    <input asp-for="VehiclePrice" class="form-control" placeholder="e.g 500000" />
                    <span asp-validation-for="VehiclePrice" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Vehicle Type</label>
                    <input asp-for="VehicleType" class="form-control" placeholder="e.g SUV / Sedan" />
                    <span asp-validation-for="VehicleType" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success w-100">
                    ✔ Save Vehicle
                </button>

            </form>

        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
            ← Back to List
        </a>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}